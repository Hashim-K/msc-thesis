# Base workspace settings.
# MIR_ENV_PROFILE selects the platform file loaded after this file.
# Supported values: legion, daic, delftblue
# This loads the matching tracked platform file, e.g. .env.legion or .env.daic.
MIR_ENV_PROFILE=

# MinIO / DVC credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Weights & Biases — API key goes in .env.local (gitignored).
WANDB_PROJECT=beatlab
WANDB_CLASSIFIER_PROJECT=classifierlab
WANDB_SYSTEM_PROJECT=ritmomaestrolab
WANDB_API_KEY=
